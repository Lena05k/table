{# Таблица со списком документов — Vue-виджет vue-dp-documents-table #}

{% if dataTable is iterable and dataTable|length > 0 %}

    {# Размер всплывающего окна при открытии документа #}
    {% if classId == 15 %}
        {% set windowHeight = 335 %}
        {% set windowWidth  = 850 %}
    {% else %}
        {% set windowHeight = 710 %}
        {% set windowWidth  = 1100 %}
    {% endif %}

    {# Собираем массив ID документов в том же порядке что строки #}
    {% set docIdsArr %}[{% for tableRow in dataTable %}{{ tableRow.ID }}{% if not loop.last %},{% endif %}{% endfor %}]{% endset %}

    <div id="tablewrapper" class="doc-list-table">

        {# ── Переключатель Таблица / Канбан ──────────────────────────────── #}
        {% if kanbanPlugin %}
            <button id="showTableBtn" type="button" disabled>Таблица</button>
            <button id="showKanbanBtn" type="button">Канбан</button>
        {% endif %}

        {# ── Пагинация (серверная) ────────────────────────────────────────── #}
        {% if hasPagination %}
            <div class="pagination pagination__top">
                {{ _self.paginate(paginationPages, paginationTotal, formatter) }}
            </div>
        {% endif %}

        {# ── Vue-таблица (заменяет старый <table>) ───────────────────────── #}
        <div id="tableView">
            <vue-dp-documents-table
                id="vue-dp-documents-table-{{ classId }}"
                columns-json="{{ fieldAlias|json_encode|e('html') }}"
                rows-json="{{ dataTable|json_encode|e('html') }}"
                doc-ids-json="{{ docIdsArr|e('html') }}"
                class-id="{{ classId }}"
                {% if documentData %}
                parent-document-id="{{ documentData.OBJ_ID }}"
                {% endif %}
            ></vue-dp-documents-table>
        </div>

        {# ── Канбан-плагин (не тронут, остаётся как был) ─────────────────── #}
        {% if kanbanPlugin %}
            <div id="kanbanView" style="display: none">
                <div class="kanban-wrapper">
                    {{ kanbanPlugin|raw }}
                </div>
            </div>
        {% endif %}

    </div>

{% else %}
    <div class="empty_do_list">
        <p>Поиск не дал результатов</p>
    </div>
{% endif %}

{# ── Макрос пагинации (аналог {function name=paginate} из старого шаблона) ── #}
{% macro paginate(pages, total, formatter) %}
    Навигация:
    <ul class="pagination--list">
        {% for page in pages %}
            {% if page.page %}
                <li class="pagination--item pagination--item__link">
                    {% if page.link %}
                        <a href="{{ page.link }}" title="Перейти на страницу {{ page.page }}">{{ page.page }}</a>
                    {% else %}
                        <span>{{ page.page }}</span>
                    {% endif %}
                </li>
            {% else %}
                <li class="pagination--item pagination--item__gap">...</li>
            {% endif %}
        {% endfor %}
    </ul>
    (всего <strong class="pagination--stat">{{ total }}</strong>
    {{ formatter.morph(total, 'карточка', 'карточки', 'карточек') }})
{% endmacro %}
